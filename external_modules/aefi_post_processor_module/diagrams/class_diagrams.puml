@startuml
!theme plain
title Post-traitement AEFI : services, ports et adaptateurs

package "interface" {
    class AcquisitionsPresenter {
        + refresh(force: bool)
        + process_pending(force: bool)
        + process_selection()
        + on_selection_changed(names)
    }
    class FieldMapPresenter
    class LogsPresenter
    class PostProcessorWindow
}

package "application" {
    interface IApiAcquisitionCatalogService {
        + list_acquisitions(ListAcquisitionsDTO): List<AcquisitionStatusDTO>
        + report_outcome(AcquisitionOutcomeDTO)
    }
    interface IApiPostProcessingService {
        + process_scan(ProcessScanDTO): ProcessingSummaryDTO
    }
    interface IApiFieldMapService {
        + list_steps(StepsRequestDTO): List<str>
        + load_step(LoadStepDTO): FieldMapDTO
    }
    interface ICsvScanReader
    interface IStepWriter
    interface IStepReader
}

package "domain" {
    class AcquisitionRecord {
        + recalculation_reason(forced): Optional<str>
    }
    interface IAcquisitionRepository
    class ProcessingParameters <<frozen>>
    class GridBuilder
    class PhaseCalibrator
    class AmplitudeSubtractor
    class FrameRotator
    class Interpolator
}

package "infrastructure" {
    class ExportFolderRepository
    class CsvScanReader
    class Hdf5StepWriter
    class Hdf5StepReader
    class FakeExportFolderRepository
    class FakeCsvScanReader
    class FakeHdf5StepWriter
    class FakeHdf5StepReader
}

AcquisitionsPresenter --> IApiAcquisitionCatalogService
AcquisitionsPresenter --> IApiPostProcessingService
FieldMapPresenter --> IApiFieldMapService

IApiPostProcessingService ..> ICsvScanReader
IApiPostProcessingService ..> IStepWriter
IApiFieldMapService ..> IStepReader
IApiAcquisitionCatalogService ..> IAcquisitionRepository
IApiAcquisitionCatalogService ..> AcquisitionRecord
IApiPostProcessingService ..> GridBuilder
IApiPostProcessingService ..> PhaseCalibrator
IApiPostProcessingService ..> AmplitudeSubtractor
IApiPostProcessingService ..> FrameRotator
IApiPostProcessingService ..> Interpolator
IApiPostProcessingService ..> ProcessingParameters

ExportFolderRepository ..|> IAcquisitionRepository
CsvScanReader ..|> ICsvScanReader
Hdf5StepWriter ..|> IStepWriter
Hdf5StepReader ..|> IStepReader
FakeExportFolderRepository ..|> IAcquisitionRepository
FakeCsvScanReader ..|> ICsvScanReader
FakeHdf5StepWriter ..|> IStepWriter
FakeHdf5StepReader ..|> IStepReader
@enduml
